# Environment
NODE_ENV=development
PORT=4000

# Database
MONGODB_URI=mongodb://localhost:27017/buildpilot

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM Providers (BYOK)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Logging & Telemetry
LOG_LEVEL=info

