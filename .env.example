# ==============================================================================
# BuildPilot — Environment Configuration Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM Providers (Add at least ONE provider key)
# ------------------------------------------------------------------------------
# OpenRouter (Recommended: access to Claude 3.5 Sonnet, GPT-4o, DeepSeek, etc.)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Direct Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Direct Google Gemini API Key
GEMINI_API_KEY=AIzaSy-your-gemini-key-here

# Direct OpenAI API Key (or local Ollama / Groq)
OPENAI_API_KEY=sk-proj-your-openai-key-here
# Optional: Set base URL for local Ollama (e.g. http://localhost:11434/v1) or Groq
# OPENAI_BASE_URL=http://localhost:11434/v1

# Default Provider & Model
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 2. GitHub Integration (For automatic webhook intake & PR creation)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo & pull_requests permissions
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitHub Webhook Secret (configured in your GitHub repository webhook settings)
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ------------------------------------------------------------------------------
# 3. Database & Queue Infrastructure (Defaults to local Docker Compose)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/buildpilot
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Service Ports & Public URLs
# ------------------------------------------------------------------------------
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 5. Security & Encryption Keys
# ------------------------------------------------------------------------------
# 32-byte AES-256 encryption key for credentials at rest
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=buildpilot_dev_jwt_secret_change_in_production
