    "@buildpilot/llm": "workspace:*",
    "@buildpilot/observability": "workspace:*",
    "@buildpilot/shared": "workspace:*",
    "@buildpilot/tools": "workspace:*",
    "bullmq": "^5.34.11",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
